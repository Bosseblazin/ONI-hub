# OniMcp endpoint (the ONI MCP Server mod). Default port 8788.
ONI_MCP_URL=http://127.0.0.1:8788/mcp/
# Only needed if you enabled AuthEnabled in OniMcpConfig.json
ONI_MCP_TOKEN=
# Optional: enables the AI Colony Advisor (Claude). Leave empty to disable.
ANTHROPIC_API_KEY=
# Optional override of the advisor model
ADVISOR_MODEL=
# Where history/alert state is written (default ./data)
IC_DATA_DIR=
# --- Remote Commander (see docs/REMOTE_ACCESS.md) ---
# Push notifications via ntfy (use a long random topic, or a token on a protected/self-hosted server)
NTFY_URL=
NTFY_TOKEN=
# Your tailnet URL (notification click target), e.g. https://homepc.your-tailnet.ts.net
IC_PUBLIC_URL=
# Optional generic JSON webhook for notifications
IC_WEBHOOK_URL=
# Dead-man's switch: pinged every minute (e.g. a healthchecks.io check URL)
IC_HEARTBEAT_URL=
# Model for instruction interpretation and investigations
OPS_MODEL=

# --- Cloud deployment (see docs/DEPLOYMENT.md) ---
# On VERCEL (production env, Sensitive): IC_MODE=cloud, IC_PASSPHRASE_HASH, IC_AGENT_SECRET; DATABASE_URL comes from the Neon integration.
# Never set IC_ALLOW_SIMULATED on production (only on a separate demo deployment).
# On the HOME PC (for npm run agent):
IC_RELAY_URL=
IC_AGENT_SECRET=
# Optional display name for this home agent (defaults to the hostname)
IC_AGENT_ID=
